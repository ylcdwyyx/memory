#!/bin/sh
# 跨项目 Git Hook 模板。当前调用方：wechat、wa、business、alibaba。
# 注意：不要改回 "#!/usr/bin/env sh"。Git for Windows 下由 git commit 拉起钩子时，
# env 在子进程 PATH 里找不到 sh（PATH 被重建为仅含 mingw64\bin），提交必然失败并报
# "/usr/bin/env: 'sh': No such file or directory"；#!/bin/sh 由 MSYS 直接按安装根解析，稳定可用。
set -u

project_root=$(git rev-parse --show-toplevel) || exit 1
cd "$project_root" || exit 1

if ! command -v pwsh >/dev/null 2>&1; then
    echo "[pre-commit] 未找到 pwsh，无法执行 scripts/verify.ps1。"
    exit 1
fi

pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1 -Scope fast
status=$?
if [ "$status" -ne 0 ]; then
    echo "[pre-commit] 自动验收失败，已取消提交。"
fi
exit "$status"
